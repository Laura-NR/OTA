# The backup service's settings (docs/deployment-plan.md D11, B11). Copy to
# deploy/backup.env on the server (gitignored, mode 600) and fill in; only the
# `backup` container loads it. The database passwords come from deploy/.env.
# Uncommented lines are needed; a commented one keeps its default.

# --- Encryption (age) ---------------------------------------------------------
# Public keys only (age1...), space-separated; every backup is readable by each.
# Make the key pair on a trusted machine, never on the server:
#   docker compose -f deploy/compose.prod.yml run --rm --entrypoint age-keygen backup
# The private key (AGE-SECRET-KEY-1...) goes to the password manager with an
# offline copy, never next to the backups or on the server; a restore mounts it
# for that run only. Two keys (two founders) means either can restore.
AGE_RECIPIENTS=

# --- Off-site storage (rclone) ------------------------------------------------
# <remote>:<bucket>[/<folder>]; a different provider or region than the server.
BACKUP_REMOTE=offsite:
# The remote `offsite`, defined by environment (https://rclone.org/docs/#config-file),
# e.g. an S3-compatible bucket with versioning on and keys limited to that bucket:
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# --- The nightly result by email (D17: a failure must be loud) ----------------
# Who gets "Backup OK" / "Backup FAILED". The SMTP lines are the API's (api.env).
BACKUP_MAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Retention (pending counsel, D11) -----------------------------------------
# Dailies and pre-deploy dumps, and the month's first daily kept as its monthly.
# BACKUP_KEEP_DAILY=30d
# BACKUP_KEEP_MONTHLY=186d
