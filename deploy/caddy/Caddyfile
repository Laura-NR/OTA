# The edge proxy (docs/deployment-plan.md D9): automatic HTTPS, security
# headers, and the visitor's address in X-Forwarded-For (Caddy replaces any
# value a client sends). Names come from deploy/.env through compose.prod.yml.
# A `*.localhost` name gets a certificate from Caddy's own local CA, so the
# same file serves the local rehearsal.
{
	email {$ACME_EMAIL}
}

(headers) {
	header {
		# No preload until every subdomain is HTTPS for good.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}
}

# trial: basic auth and noindex on all three sites; open: neither (D18).
(gate) {
	import gates/{$SITE_GATE}.caddy
}

{$SITE_DOMAIN} {
	import headers
	import gate
	header X-Frame-Options "DENY"
	encode zstd gzip
	reverse_proxy storefront:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$DESK_DOMAIN} {
	import headers
	import gate
	# The desk frames a supplier's credential from its own origin.
	header X-Frame-Options "SAMEORIGIN"
	encode zstd gzip
	# Live updates reach the API through the desk's own host, so they carry the
	# desk's cookie (D7a, D8a).
	reverse_proxy /socket.io/* api:3001
	reverse_proxy desk:3002
}

# The worker app (docs/worker-app-distribution-plan.md U1a), outside the trial
# gate so approved workers can install and sign in. Only the download page and
# the phone's own token-authenticated calls get through (D8); any other path
# goes to the main site, gate included.
app.{$SITE_DOMAIN} {
	import headers
	header X-Frame-Options "DENY"
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	@phone path /worker/* /worker-app/* /api/auth/sign-in/worker-code /api/auth/sign-in/worker-code/send
	handle @phone {
		reverse_proxy api:3001
	}
	@answer path_regexp ^/service-items/[^/]+/(accept|decline)$
	handle @answer {
		reverse_proxy api:3001
	}
	handle / {
		rewrite * /app
		reverse_proxy storefront:3000
	}
	@page path /app /en/app /fr/app /_next/* /api/ota/worker-app/*
	handle @page {
		reverse_proxy storefront:3000
	}
	handle {
		redir https://{$SITE_DOMAIN}{uri}
	}
}

{$ANALYTICS_DOMAIN} {
	import headers
	import gate
	header X-Frame-Options "DENY"
	encode zstd gzip
	reverse_proxy plausible:8000
}
