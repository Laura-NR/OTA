# Compose's settings for production (docs/deployment-plan.md D8, B5). Copy to
# deploy/.env on the server (gitignored, mode 600) and fill in. Compose reads it
# for the ${...} values in compose.prod.yml; no container loads it whole. The
# API's own settings are in deploy/api.env (api.env.example), the backups' in
# deploy/backup.env (backup.env.example).
# Single-quote any value that contains `$` (the trial password hash does):
# Compose would otherwise expand it.
# Uncommented lines are needed; a commented one keeps its default.

# --- Hosts and the edge (Caddy) ----------------------------------------------
# The agency's domain, e.g. veredaexpeditions.com (D6a).
SITE_DOMAIN=
# desk.<domain>; also baked into the desk image at build (its live socket).
DESK_DOMAIN=
# analytics.<domain> (Plausible CE, deploy/plausible/compose.override.yml).
ANALYTICS_DOMAIN=
# Let's Encrypt account and expiry notices.
ACME_EMAIL=
# trial: basic auth and X-Robots-Tag noindex on all three sites (D18); open at launch.
SITE_GATE=trial
TRIAL_USER=
# docker compose -f deploy/compose.prod.yml run --rm caddy caddy hash-password
TRIAL_PASSWORD_HASH=''
# 1 during the trial (robots.txt says Disallow); empty at launch.
SITE_NOINDEX=1

# --- Images -------------------------------------------------------------------
# Registry path and release tag the server pulls (B3), e.g. ghcr.io/<owner>/ota
# and v1.0.0. Defaults: ota and local (images built on the machine).
# deploy/deploy.sh writes OTA_VERSION after each healthy deploy.
# OTA_IMAGE_PREFIX=
# OTA_VERSION=

# --- Database and Redis (internal network only) ------------------------------
# The schema owner: runs the migrations only (compose service `migrate`).
POSTGRES_USER=ota
POSTGRES_DB=ota
# openssl rand -hex 24
POSTGRES_PASSWORD=
# The API's role: data only, no DDL (deploy/postgres/init/10-runtime-role.sh, B4).
# POSTGRES_APP_USER=ota_app
# openssl rand -hex 24
POSTGRES_APP_PASSWORD=
# openssl rand -hex 24
REDIS_PASSWORD=
