# Production settings (docs/deployment-plan.md D8, B5). Copy to deploy/.env on
# the server (gitignored, mode 600) and fill in. Compose reads it for the ${...}
# values in compose.prod.yml, and the API container loads it whole; the
# storefront and desk receive only API_URL and SITE_NOINDEX.
# Single-quote any value that contains `$` (the trial password hash does):
# Compose would otherwise expand it.
# Uncommented lines are needed; a commented one keeps its default. Never leave
# an optional line as `KEY=`: an empty value is not the same as unset.
# Set by compose.prod.yml, not here: DATABASE_URL, REDIS_URL, DOCUMENTS_DIR,
# TZ=America/Havana, TRUST_PROXY=1, API_URL, NODE_ENV, PORT.

# --- Hosts and the edge (Caddy) ----------------------------------------------
# The agency's domain, e.g. veredaexpeditions.com (D6a).
SITE_DOMAIN=
# desk.<domain>; also baked into the desk image at build (its live socket).
DESK_DOMAIN=
# analytics.<domain> (Plausible CE, deploy/plausible/compose.override.yml).
ANALYTICS_DOMAIN=
# Let's Encrypt account and expiry notices.
ACME_EMAIL=
# trial: basic auth and X-Robots-Tag noindex on all three sites (D18); open at launch.
SITE_GATE=trial
TRIAL_USER=
# docker compose -f deploy/compose.prod.yml run --rm caddy caddy hash-password
TRIAL_PASSWORD_HASH=''
# 1 during the trial (robots.txt says Disallow); empty at launch.
SITE_NOINDEX=1

# --- Images -------------------------------------------------------------------
# Registry path and release tag the server pulls (B3), e.g. ghcr.io/<owner>/ota
# and v1.0.0. Defaults: ota and local (images built on the machine).
# OTA_IMAGE_PREFIX=
# OTA_VERSION=

# --- Database and Redis (internal network only) ------------------------------
POSTGRES_USER=ota
POSTGRES_DB=ota
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 24
REDIS_PASSWORD=

# --- Sign-in (D7a, B6) --------------------------------------------------------
# openssl rand -hex 32. Required: the API refuses to start without it.
AUTH_SECRET=
# https://<domain>,https://desk.<domain>
TRUSTED_ORIGINS=
# <domain>,desk.<domain>: each site signs in on its own host.
AUTH_ALLOWED_HOSTS=
# https://<domain>: the fallback for a request with no allowed host. Never the internal http://api:3001.
BETTER_AUTH_URL=
# <domain> (not desk.<domain>), so traveler passkeys stay possible later (D6, F14).
# Binds every passkey for good: changing it means everyone enrolls again.
PASSKEY_RP_ID=
# Sign-in link lifetime in minutes (default 10) and staff session length in hours (default 12).
# MAGIC_LINK_EXPIRES_MINUTES=
# STAFF_SESSION_HOURS=
# Break-glass only (runbook): `off` suspends the staff passkey rule or the
# Super Admin IP allowlist until removed. Leave empty.
# STAFF_PASSKEYS_OVERRIDE=
# SUPER_ADMIN_IP_ALLOWLIST_OVERRIDE=

# --- Passport numbers ----------------------------------------------------------
# A 32-byte key (runbook "Passport numbers"). Generate it on the server, keep a
# copy in the password manager, never in a ticket or chat. Unset: passport
# numbers cannot be stored or read (503); a malformed key stops the API.
PASSPORT_ENCRYPTION_KEY=

# --- Public links in emails and pages ------------------------------------------
# https://<domain>
STOREFRONT_PUBLIC_URL=
PORTAL_URL=
PAYMENT_CHECKOUT_BASE_URL=
# https://desk.<domain>
BACKOFFICE_PUBLIC_URL=
# https://<domain>/api/ota: the retention keep-alive link goes through the storefront (D8a).
API_PUBLIC_URL=

# --- Email (D13) -----------------------------------------------------------------
# Without SMTP_HOST and MAIL_FROM the API only logs mail (no sign-in links go out).
# Use the provider's STARTTLS port (587): the client does not open implicit TLS (465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. Vereda Expeditions <info@<domain>>
MAIL_FROM=
# Operations alerts and the weekly analytics digest (the digest falls back to OPS_NOTIFY_EMAIL).
OPS_NOTIFY_EMAIL=
# ANALYTICS_DIGEST_EMAIL=

# --- Object storage for uploads (D12a) ------------------------------------------
# Without the keys the API keeps supplier credentials and images IN MEMORY:
# they are lost on every restart. Required in production.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payments (ADR 0005) ----------------------------------------------------------
# Defaults: wire transfer live, card on the mock until TropiPay.
# PAYMENT_PROVIDER_BANK_TRANSFER=
# PAYMENT_PROVIDER_CARD=

# --- Analytics (T-Events; runbook "Analytics events") -----------------------------
# mock (default) or plausible. For plausible:
# TELEMETRY_PLAUSIBLE_ENDPOINT=http://plausible:8000/api/event and
# TELEMETRY_PLAUSIBLE_SITE_URL=https://<domain>.
# TELEMETRY_SINK=
# TELEMETRY_PLAUSIBLE_ENDPOINT=
# TELEMETRY_PLAUSIBLE_SITE_URL=
# TELEMETRY_PLAUSIBLE_DOMAIN=
# TELEMETRY_PLAUSIBLE_USER_AGENT=
# TELEMETRY_PLAUSIBLE_TIMEOUT_MS=

# --- Assistant ------------------------------------------------------------------
# mock until a provider is chosen (production-readiness §6).
# AI_PROVIDER=

# --- Limits ------------------------------------------------------------------------
# Per IP per window (defaults 600, auth 30, window 60000 ms). One API process (F7).
# RATE_LIMIT_MAX=
# RATE_LIMIT_AUTH_MAX=
# RATE_LIMIT_WINDOW_MS=
# Graceful shutdown bound (default 10000); keep below the 30 s stop_grace_period.
# SHUTDOWN_TIMEOUT_MS=
