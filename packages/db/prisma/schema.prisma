// OTA core schema. Mirrors spec §6 with snake_case columns matching the data
// dictionary. Inventory/CMS and pricing tables land in Phase 2.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  ADMINISTRATIVE_SUPPORT
  SERVICE_WORKER
  TRAVELER
}

enum ReservationStatus {
  DRAFT
  ITINERARY_SUBMITTED
  DISPATCH_IN_PROGRESS
  ASSEMBLY_AND_ESCALATION
  SECURED_AND_INVOICED
  PENDING_PAYMENT
  ACTION_REQUIRED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceType {
  GUIDE
  TRANSPORTATION
  ACCOMMODATION
  EXPERIENCE
}

enum ServiceItemStatus {
  UNASSIGNED
  OFFERED
  ACCEPTED
  DECLINED
  TIMEOUT
  FULFILLED
}

enum DispatchOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  TIMEOUT
  CANCELLED
}

enum InventoryType {
  ACCOMMODATION
  TRANSPORT
  EXPERIENCE
}

enum PricingRuleKind {
  SEASONAL_RATE
  MARKUP
}

enum ImportBatchStatus {
  STAGED
  COMMITTED
  FAILED
}

enum SupplierCategory {
  TOUR_GUIDE
  PRIVATE_DRIVER
  HOMESTAY_HOST
  TRANSLATOR
}

enum VerificationStatus {
  PENDING_AUDIT
  VERIFIED
  REJECTED
  SUSPENDED
}

enum SupplierApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentRail {
  OPEN_BANKING_SEPA
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PayoutStatus {
  ACCRUED
  PROCESSING
  SETTLED
  FAILED
}

enum DocumentType {
  VOUCHER
  WORK_ORDER
  INVOICE
  RECEIPT
  EMERGENCY_CONTACT
}

// Statutory tourism classification used for the ecotourism/specialised-tourism
// ratio and the MINTUR annual activity summary (spec §4.9.2). GENERAL is the
// default so existing bookings remain reportable; operators classify the rest.
enum TourismCategory {
  ECOTOURISM
  AGROTOURISM
  NATURE
  CULTURAL
  GENERAL
}

enum MessageSender {
  TRAVELER
  OPERATIONS
}

// Publish lifecycle of a curated package. Only PUBLISHED shows on the public
// catalog; ARCHIVED keeps the row for the bookings that reference it.
enum PackageStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

// REQUEST: hosts confirm within the tenant's response window. INSTANT needs
// every component allotment-backed; nothing is today, so the publish check
// refuses INSTANT until allotments exist (A-Package-Edit draws it locked).
enum BookingModel {
  REQUEST
  INSTANT
}

enum DepartureStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ExtraPriceUnit {
  PER_PERSON
  PER_BOOKING
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  role          Role     @default(TRAVELER)
  fullName      String?  @map("full_name")
  image         String?
  phone         String?
  // ISO 3166-1 alpha-2, captured at booking for the MINTUR nationality
  // breakdown (spec §4.9.2). Null until the traveler or an operator supplies it.
  nationality   String?
  locale        String   @default("es")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // GDPR retention lifecycle (spec §3.5)
  retentionConsentGrantedAt DateTime? @map("retention_consent_granted_at")
  retentionNoticeSentAt     DateTime? @map("retention_notice_sent_at")
  anonymizedAt              DateTime? @map("anonymized_at")

  supplierProfile SupplierProfile?
  reservations    Reservation[]
  auditLogs       AuditLog[]

  // Better Auth relations
  sessions Session[]
  accounts Account[]
  passkeys Passkey[]

  @@map("users")
}

// --- Better Auth core schema -------------------------------------------------
// Field names follow Better Auth's expected model shape; table names are the
// adapter defaults (singular). Column names stay camelCase because these tables
// are owned by Better Auth, not the OTA domain.

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String   @db.Uuid
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkey")
}

model SupplierProfile {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  category              SupplierCategory
  primaryPhone          String             @map("primary_phone")
  provincesActive       String[]           @map("provinces_active")
  vehicleDetails        Json?              @map("vehicle_details")
  rtnLicenseNumber      String             @unique @map("rtn_license_number")
  credentialDocumentUrl String?            @map("credential_document_url")
  credentialExpiresAt   DateTime?          @map("credential_expires_at")
  verificationStatus    VerificationStatus @default(PENDING_AUDIT) @map("verification_status")
  isAvailable           Boolean            @default(true) @map("is_available")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceItems ServiceItem[]
  availabilities Availability[]
  dispatchOffers DispatchOffer[]
  inventoryItems InventoryItem[]

  @@index([verificationStatus])
  @@map("supplier_profiles")
}

// Public recruitment application (spec §4.6 supplier management). Approved
// applications provision a User + SupplierProfile; nothing is created until an
// operator approves, so a stray application cannot collide with Better Auth.
model SupplierApplication {
  id               String                    @id @default(uuid()) @db.Uuid
  fullName         String                    @map("full_name")
  email            String
  phone            String
  category         SupplierCategory
  provincesActive  String[]                  @map("provinces_active")
  rtnLicenseNumber String                    @map("rtn_license_number")
  message          String?
  status           SupplierApplicationStatus @default(PENDING)
  reviewedByUserId String?                   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?                 @map("reviewed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@map("supplier_applications")
}

// Catalog entity displayed on the storefront and used by the pricing engine.
// CRM (inventory/CMS) — separate from the storefront content hub.
model InventoryItem {
  id          String        @id @default(uuid()) @db.Uuid
  type        InventoryType
  name        String
  description String?
  province    String?
  currency    String        @default("EUR")
  basePrice   Decimal       @map("base_price") @db.Decimal(10, 2)
  active      Boolean       @default(true)
  attributes  Json?
  supplierId  String?       @map("supplier_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  supplier        SupplierProfile? @relation(fields: [supplierId], references: [id])
  pricingRules    PricingRule[]
  media           InventoryMedia[]
  packageServices PackageService[]
  packageExtras   PackageExtra[]

  @@index([type])
  @@index([province])
  @@index([active])
  @@map("inventory_items")
}

// Curated multi-day package (spec §3.3): a fixed-schedule template of catalog
// services that expands into a Reservation's ServiceItems when booked. Kept
// separate from InventoryItem because a bundle is not a single sellable SKU.
model Package {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  // Card text (A-Package-Edit: 160–220 characters).
  summary     String?
  province    String?
  durationDays Int     @map("duration_days")
  currency    String   @default("EUR")
  // Per person, before the tier delta, for a date with no departure price.
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  status      PackageStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  // Locale of the text on this row and on its days, tiers, extras and media;
  // PackageTranslation overlays the other locales.
  sourceLocale     String   @default("en") @map("source_locale")
  // Set by the API when source text changes; a translation made from an
  // older value is outdated.
  contentUpdatedAt DateTime @default(now()) @map("content_updated_at")
  bookingModel     BookingModel    @default(REQUEST) @map("booking_model")
  // Departs with groupMin travelers; null bounds mean no limit.
  groupMin         Int?            @map("group_min")
  groupMax         Int?            @map("group_max")
  leadTimeDays     Int             @default(2) @map("lead_time_days")
  // Copied onto the reservation when a traveler books this package.
  tourismCategory  TourismCategory @default(GENERAL) @map("tourism_category")
  // Tenant theme keys, the same vocabulary as tenant/destinations.json.
  themes           String[]        @default([])
  // 1 (gentle) to 5 (demanding).
  difficulty       Int?
  accessibility    String[]        @default([])
  // Keys into the manifest's policies; null is the tenant default.
  cancellationPolicy String?       @map("cancellation_policy")
  depositPolicy      String?       @map("deposit_policy")
  included         String[]        @default([])
  excluded         String[]        @default([])
  cubaNotes        String?         @map("cuba_notes")
  seoTitle         String?         @map("seo_title")
  seoDescription   String?         @map("seo_description")
  attributes  Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services      PackageService[]
  reservations  Reservation[]
  days          PackageDay[]
  tiers         PackageTier[]
  departures    PackageDeparture[]
  extras        PackageExtra[]
  media         PackageMedia[]
  translations  PackageTranslation[]
  slugRedirects PackageSlugRedirect[]

  @@index([status])
  @@index([province])
  @@map("packages")
}

// One catalog item inside a package itinerary. `dayOffset` is the day within
// the package (day 0 = first day); `position` orders items on the same day.
model PackageService {
  id              String   @id @default(uuid()) @db.Uuid
  packageId       String   @map("package_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  // Null: every tier books this service. Set: only that tier (its casa).
  tierId          String?  @map("tier_id") @db.Uuid
  dayOffset       Int      @default(0) @map("day_offset")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  package       Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  tier          PackageTier?  @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([tierId])
  @@map("package_services")
}

// The words for one itinerary day. The services the day uses stay in
// PackageService, keyed by the same dayOffset.
model PackageDay {
  id        String  @id @default(uuid()) @db.Uuid
  packageId String  @map("package_id") @db.Uuid
  dayOffset Int     @map("day_offset")
  title     String
  body      String?
  meals     String?

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, dayOffset])
  @@map("package_days")
}

// An accommodation tier: it changes the stays, never the route. Its price is
// a delta over the departure price, so a season moves every tier together.
model PackageTier {
  id               String   @id @default(uuid()) @db.Uuid
  packageId        String   @map("package_id") @db.Uuid
  code             String
  name             String
  description      String?
  position         Int      @default(0)
  priceDelta       Decimal  @default(0) @map("price_delta") @db.Decimal(10, 2)
  singleSupplement Decimal? @map("single_supplement") @db.Decimal(10, 2)
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  package  Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  services PackageService[]

  @@unique([packageId, code])
  @@map("package_tiers")
}

// A fixed departure. It ends on startDate + durationDays - 1. Places left are
// capacity minus the travelers booked on it, which M2 records.
model PackageDeparture {
  id        String          @id @default(uuid()) @db.Uuid
  packageId String          @map("package_id") @db.Uuid
  startDate DateTime        @map("start_date") @db.Date
  capacity  Int
  // Per person, before the tier delta; null is Package.basePrice. The season
  // label ("High · +25 %") is derived from the difference.
  price     Decimal?        @db.Decimal(10, 2)
  status    DepartureStatus @default(OPEN)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, startDate])
  @@index([startDate])
  @@map("package_departures")
}

// An optional add-on (an activity, an extra night). When it is linked to a
// catalog item it is dispatched like any service.
model PackageExtra {
  id              String         @id @default(uuid()) @db.Uuid
  packageId       String         @map("package_id") @db.Uuid
  code            String
  name            String
  description     String?
  durationLabel   String?        @map("duration_label")
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  dayOffset       Int?           @map("day_offset")
  price           Decimal        @db.Decimal(10, 2)
  priceUnit       ExtraPriceUnit @default(PER_PERSON) @map("price_unit")
  position        Int            @default(0)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  package       Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@unique([packageId, code])
  @@map("package_extras")
}

// Package photos; position 0 is the hero. The binary is in object storage
// (packages/<packageId>/<uuid>.<ext>) and the content type comes from the key,
// as for InventoryMedia. A photo that shows people needs a consent reference
// before the package can publish.
model PackageMedia {
  id               String   @id @default(uuid()) @db.Uuid
  packageId        String   @map("package_id") @db.Uuid
  storageKey       String   @map("storage_key")
  altText          String   @map("alt_text")
  position         Int      @default(0)
  showsPeople      Boolean  @default(false) @map("shows_people")
  consentReference String?  @map("consent_reference")
  createdAt        DateTime @default(now()) @map("created_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_media")
}

// One locale's overlay of a package's words; anything missing falls back to
// the source locale. Nested words are keyed by the source's stable keys: days
// by dayOffset, tiers and extras by code, media by id. @ota/schemas validates
// the JSON.
model PackageTranslation {
  id              String   @id @default(uuid()) @db.Uuid
  packageId       String   @map("package_id") @db.Uuid
  locale          String
  name            String?
  summary         String?
  description     String?
  included        String[] @default([])
  excluded        String[] @default([])
  cubaNotes       String?  @map("cuba_notes")
  seoTitle        String?  @map("seo_title")
  seoDescription  String?  @map("seo_description")
  days            Json?
  tiers           Json?
  extras          Json?
  mediaAlt        Json?    @map("media_alt")
  // Drafted text waits for a reviewer before travelers see it.
  published       Boolean  @default(false)
  // Package.contentUpdatedAt when this translation was last brought in line.
  sourceUpdatedAt DateTime @map("source_updated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, locale])
  @@map("package_translations")
}

// A retired slug that redirects to its package. The API keeps a retired slug
// from being taken by another package.
model PackageSlugRedirect {
  slug      String   @id
  packageId String   @map("package_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_slug_redirects")
}

// Gallery images for a catalog item (spec §4.6). The binary lives in object
// storage; only the private key is kept here — the content type is derived from
// the key extension, as with supplier credentials.
model InventoryMedia {
  id              String   @id @default(uuid()) @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  storageKey      String   @map("storage_key")
  altText         String?  @map("alt_text")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@map("inventory_media")
}

// Seasonal rate overrides and agency markups. A null inventoryItemId on a
// MARKUP rule means it applies to every item.
model PricingRule {
  id              String          @id @default(uuid()) @db.Uuid
  inventoryItemId String?         @map("inventory_item_id") @db.Uuid
  kind            PricingRuleKind
  label           String
  startDate       DateTime?       @map("start_date") @db.Date
  endDate         DateTime?       @map("end_date") @db.Date
  amount          Decimal?        @db.Decimal(10, 2)
  percent         Decimal?        @db.Decimal(5, 2)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@map("pricing_rules")
}

// Staging record for a bulk spreadsheet import: detected columns, parsed rows,
// and the committed mapping. Committing creates InventoryItems.
model ImportBatch {
  id              String            @id @default(uuid()) @db.Uuid
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  filename        String
  status          ImportBatchStatus @default(STAGED)
  columns         String[]
  rowCount        Int               @map("row_count")
  rows            Json
  mapping         Json?
  importedCount   Int?              @map("imported_count")
  errors          Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@map("import_batches")
}

model Reservation {
  id                      String            @id @default(uuid()) @db.Uuid
  userId                  String            @map("user_id") @db.Uuid
  // Set when the booking was created from a curated package (spec §3.3); null
  // for custom dynamic-builder itineraries. Drives the package-type AOV split.
  packageId               String?           @map("package_id") @db.Uuid
  bookingCode             String            @unique @map("booking_code")
  startDate               DateTime          @map("start_date") @db.Date
  endDate                 DateTime          @map("end_date") @db.Date
  status                  ReservationStatus @default(DRAFT)
  tourismCategory         TourismCategory   @default(GENERAL) @map("tourism_category")
  // Set when the booking reaches COMPLETED; anchors the GDPR retention clock
  // (spec §3.5): 6 months later the traveler is notified, then a 30-day grace.
  completedAt             DateTime?         @map("completed_at")
  totalCurrency           String            @default("EUR") @map("total_currency")
  totalAmount             Decimal           @default(0) @map("total_amount") @db.Decimal(10, 2)
  customItineraryPayload  Json?             @map("custom_itinerary_payload")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id])
  package     Package?        @relation(fields: [packageId], references: [id])
  serviceItems ServiceItem[]
  payments    PaymentReceipt[]
  documents   Document[]
  messages    Message[]
  reviews     Review[]
  incidents   Incident[]

  @@index([userId])
  @@index([status])
  @@index([packageId])
  @@index([completedAt])
  @@map("reservations")
}

model ServiceItem {
  id               String            @id @default(uuid()) @db.Uuid
  reservationId    String            @map("reservation_id") @db.Uuid
  supplierId       String?           @map("supplier_id") @db.Uuid
  serviceType      ServiceType       @map("service_type")
  serviceDateStart DateTime          @map("service_date_start")
  serviceDateEnd   DateTime          @map("service_date_end")
  province         String?
  status           ServiceItemStatus @default(UNASSIGNED)
  dispatchDeadline DateTime?         @map("dispatch_deadline")
  offeredAt        DateTime?         @map("offered_at")
  respondedAt      DateTime?         @map("responded_at")
  declineReason    String?           @map("decline_reason")
  payoutRate       Decimal           @default(0) @map("payout_rate") @db.Decimal(10, 2)
  payoutStatus     PayoutStatus      @default(ACCRUED) @map("payout_status")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  reservation Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  supplier    SupplierProfile? @relation(fields: [supplierId], references: [id])
  dispatchOffers DispatchOffer[]

  @@index([reservationId])
  @@index([supplierId])
  @@index([status])
  @@map("service_items")
}

// Ledger of every dispatch offer, including superseded and re-routed ones.
// ServiceItem holds the current offer's state; this table is the history used
// for escalation and worker reliability scorecards.
model DispatchOffer {
  id            String               @id @default(uuid()) @db.Uuid
  serviceItemId String               @map("service_item_id") @db.Uuid
  supplierId    String               @map("supplier_id") @db.Uuid
  status        DispatchOfferStatus  @default(OFFERED)
  offeredAt     DateTime             @default(now()) @map("offered_at")
  deadline      DateTime
  respondedAt   DateTime?            @map("responded_at")
  declineReason String?              @map("decline_reason")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  serviceItem ServiceItem      @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  supplier    SupplierProfile  @relation(fields: [supplierId], references: [id])

  @@index([serviceItemId])
  @@index([supplierId])
  @@index([status])
  @@map("dispatch_offers")
}

model PaymentReceipt {
  id           String        @id @default(uuid()) @db.Uuid
  reservationId String       @map("reservation_id") @db.Uuid
  gatewayTxId  String?       @map("gateway_tx_id")
  rail         PaymentRail
  currency     String        @default("EUR")
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  payoutStatus PayoutStatus  @default(ACCRUED) @map("payout_status")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("payment_receipts")
}

model Document {
  id            String       @id @default(uuid()) @db.Uuid
  reservationId String       @map("reservation_id") @db.Uuid
  type          DocumentType
  storageKey    String       @map("storage_key")
  generatedAt   DateTime     @default(now()) @map("generated_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("documents")
}

model Message {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @map("reservation_id") @db.Uuid
  sender        MessageSender
  body          String
  readAt        DateTime?     @map("read_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("messages")
}

model Availability {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  date       DateTime @db.Date
  isAvailable Boolean @default(true) @map("is_available")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, date])
  @@map("availabilities")
}

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  supplierId    String?  @map("supplier_id") @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("reviews")
}

model Incident {
  id            String    @id @default(uuid()) @db.Uuid
  reservationId String    @map("reservation_id") @db.Uuid
  category      String
  description   String
  severity      String
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("incidents")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
