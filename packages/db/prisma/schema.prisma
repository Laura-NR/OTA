// OTA core schema. Mirrors spec §6 with snake_case columns matching the data
// dictionary. Inventory/CMS and pricing tables land in Phase 2.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  ADMINISTRATIVE_SUPPORT
  SERVICE_WORKER
  TRAVELER
}

enum ReservationStatus {
  DRAFT
  ITINERARY_SUBMITTED
  DISPATCH_IN_PROGRESS
  ASSEMBLY_AND_ESCALATION
  SECURED_AND_INVOICED
  PENDING_PAYMENT
  ACTION_REQUIRED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceType {
  GUIDE
  TRANSPORTATION
  ACCOMMODATION
  EXPERIENCE
}

enum ServiceItemStatus {
  UNASSIGNED
  OFFERED
  ACCEPTED
  DECLINED
  TIMEOUT
  FULFILLED
}

enum DispatchOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  TIMEOUT
  CANCELLED
}

enum InventoryType {
  ACCOMMODATION
  TRANSPORT
  EXPERIENCE
}

enum PricingRuleKind {
  SEASONAL_RATE
  MARKUP
}

enum ImportBatchStatus {
  STAGED
  COMMITTED
  FAILED
}

enum SupplierCategory {
  TOUR_GUIDE
  PRIVATE_DRIVER
  HOMESTAY_HOST
  TRANSLATOR
}

enum VerificationStatus {
  PENDING_AUDIT
  VERIFIED
  REJECTED
  SUSPENDED
}

enum SupplierApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentRail {
  OPEN_BANKING_SEPA
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PayoutStatus {
  ACCRUED
  PROCESSING
  SETTLED
  FAILED
}

enum DocumentType {
  VOUCHER
  WORK_ORDER
  INVOICE
  RECEIPT
  EMERGENCY_CONTACT
}

// Statutory tourism classification used for the ecotourism/specialised-tourism
// ratio and the MINTUR annual activity summary (spec §4.9.2). GENERAL is the
// default so existing bookings remain reportable; operators classify the rest.
enum TourismCategory {
  ECOTOURISM
  AGROTOURISM
  NATURE
  CULTURAL
  GENERAL
}

enum MessageSender {
  TRAVELER
  OPERATIONS
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  role          Role     @default(TRAVELER)
  fullName      String?  @map("full_name")
  image         String?
  phone         String?
  // ISO 3166-1 alpha-2, captured at booking for the MINTUR nationality
  // breakdown (spec §4.9.2). Null until the traveler or an operator supplies it.
  nationality   String?
  locale        String   @default("es")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // GDPR retention lifecycle (spec §3.5)
  retentionConsentGrantedAt DateTime? @map("retention_consent_granted_at")
  anonymizedAt              DateTime? @map("anonymized_at")

  supplierProfile SupplierProfile?
  reservations    Reservation[]
  auditLogs       AuditLog[]

  // Better Auth relations
  sessions Session[]
  accounts Account[]
  passkeys Passkey[]

  @@map("users")
}

// --- Better Auth core schema -------------------------------------------------
// Field names follow Better Auth's expected model shape; table names are the
// adapter defaults (singular). Column names stay camelCase because these tables
// are owned by Better Auth, not the OTA domain.

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String   @db.Uuid
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkey")
}

model SupplierProfile {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  category              SupplierCategory
  primaryPhone          String             @map("primary_phone")
  provincesActive       String[]           @map("provinces_active")
  vehicleDetails        Json?              @map("vehicle_details")
  rtnLicenseNumber      String             @unique @map("rtn_license_number")
  credentialDocumentUrl String?            @map("credential_document_url")
  credentialExpiresAt   DateTime?          @map("credential_expires_at")
  verificationStatus    VerificationStatus @default(PENDING_AUDIT) @map("verification_status")
  isAvailable           Boolean            @default(true) @map("is_available")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceItems ServiceItem[]
  availabilities Availability[]
  dispatchOffers DispatchOffer[]
  inventoryItems InventoryItem[]

  @@index([verificationStatus])
  @@map("supplier_profiles")
}

// Public recruitment application (spec §4.6 supplier management). Approved
// applications provision a User + SupplierProfile; nothing is created until an
// operator approves, so a stray application cannot collide with Better Auth.
model SupplierApplication {
  id               String                    @id @default(uuid()) @db.Uuid
  fullName         String                    @map("full_name")
  email            String
  phone            String
  category         SupplierCategory
  provincesActive  String[]                  @map("provinces_active")
  rtnLicenseNumber String                    @map("rtn_license_number")
  message          String?
  status           SupplierApplicationStatus @default(PENDING)
  reviewedByUserId String?                   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?                 @map("reviewed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@map("supplier_applications")
}

// Catalog entity displayed on the storefront and used by the pricing engine.
// CRM (inventory/CMS) — separate from the storefront content hub.
model InventoryItem {
  id          String        @id @default(uuid()) @db.Uuid
  type        InventoryType
  name        String
  description String?
  province    String?
  currency    String        @default("EUR")
  basePrice   Decimal       @map("base_price") @db.Decimal(10, 2)
  active      Boolean       @default(true)
  attributes  Json?
  supplierId  String?       @map("supplier_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  supplier        SupplierProfile? @relation(fields: [supplierId], references: [id])
  pricingRules    PricingRule[]
  media           InventoryMedia[]
  packageServices PackageService[]

  @@index([type])
  @@index([province])
  @@index([active])
  @@map("inventory_items")
}

// Curated multi-day package (spec §3.3): a fixed-schedule template of catalog
// services that expands into a Reservation's ServiceItems when booked. Kept
// separate from InventoryItem because a bundle is not a single sellable SKU.
model Package {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  province    String?
  durationDays Int     @map("duration_days")
  currency    String   @default("EUR")
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  active      Boolean  @default(true)
  attributes  Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services     PackageService[]
  reservations Reservation[]

  @@index([active])
  @@index([province])
  @@map("packages")
}

// One catalog item inside a package itinerary. `dayOffset` is the day within
// the package (day 0 = first day); `position` orders items on the same day.
model PackageService {
  id              String   @id @default(uuid()) @db.Uuid
  packageId       String   @map("package_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  dayOffset       Int      @default(0) @map("day_offset")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  package       Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([packageId])
  @@map("package_services")
}

// Gallery images for a catalog item (spec §4.6). The binary lives in object
// storage; only the private key is kept here — the content type is derived from
// the key extension, as with supplier credentials.
model InventoryMedia {
  id              String   @id @default(uuid()) @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  storageKey      String   @map("storage_key")
  altText         String?  @map("alt_text")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@map("inventory_media")
}

// Seasonal rate overrides and agency markups. A null inventoryItemId on a
// MARKUP rule means it applies to every item.
model PricingRule {
  id              String          @id @default(uuid()) @db.Uuid
  inventoryItemId String?         @map("inventory_item_id") @db.Uuid
  kind            PricingRuleKind
  label           String
  startDate       DateTime?       @map("start_date") @db.Date
  endDate         DateTime?       @map("end_date") @db.Date
  amount          Decimal?        @db.Decimal(10, 2)
  percent         Decimal?        @db.Decimal(5, 2)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@map("pricing_rules")
}

// Staging record for a bulk spreadsheet import: detected columns, parsed rows,
// and the committed mapping. Committing creates InventoryItems.
model ImportBatch {
  id              String            @id @default(uuid()) @db.Uuid
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  filename        String
  status          ImportBatchStatus @default(STAGED)
  columns         String[]
  rowCount        Int               @map("row_count")
  rows            Json
  mapping         Json?
  importedCount   Int?              @map("imported_count")
  errors          Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@map("import_batches")
}

model Reservation {
  id                      String            @id @default(uuid()) @db.Uuid
  userId                  String            @map("user_id") @db.Uuid
  // Set when the booking was created from a curated package (spec §3.3); null
  // for custom dynamic-builder itineraries. Drives the package-type AOV split.
  packageId               String?           @map("package_id") @db.Uuid
  bookingCode             String            @unique @map("booking_code")
  startDate               DateTime          @map("start_date") @db.Date
  endDate                 DateTime          @map("end_date") @db.Date
  status                  ReservationStatus @default(DRAFT)
  tourismCategory         TourismCategory   @default(GENERAL) @map("tourism_category")
  totalCurrency           String            @default("EUR") @map("total_currency")
  totalAmount             Decimal           @default(0) @map("total_amount") @db.Decimal(10, 2)
  customItineraryPayload  Json?             @map("custom_itinerary_payload")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id])
  package     Package?        @relation(fields: [packageId], references: [id])
  serviceItems ServiceItem[]
  payments    PaymentReceipt[]
  documents   Document[]
  messages    Message[]
  reviews     Review[]
  incidents   Incident[]

  @@index([userId])
  @@index([status])
  @@index([packageId])
  @@map("reservations")
}

model ServiceItem {
  id               String            @id @default(uuid()) @db.Uuid
  reservationId    String            @map("reservation_id") @db.Uuid
  supplierId       String?           @map("supplier_id") @db.Uuid
  serviceType      ServiceType       @map("service_type")
  serviceDateStart DateTime          @map("service_date_start")
  serviceDateEnd   DateTime          @map("service_date_end")
  province         String?
  status           ServiceItemStatus @default(UNASSIGNED)
  dispatchDeadline DateTime?         @map("dispatch_deadline")
  offeredAt        DateTime?         @map("offered_at")
  respondedAt      DateTime?         @map("responded_at")
  declineReason    String?           @map("decline_reason")
  payoutRate       Decimal           @default(0) @map("payout_rate") @db.Decimal(10, 2)
  payoutStatus     PayoutStatus      @default(ACCRUED) @map("payout_status")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  reservation Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  supplier    SupplierProfile? @relation(fields: [supplierId], references: [id])
  dispatchOffers DispatchOffer[]

  @@index([reservationId])
  @@index([supplierId])
  @@index([status])
  @@map("service_items")
}

// Ledger of every dispatch offer, including superseded and re-routed ones.
// ServiceItem holds the current offer's state; this table is the history used
// for escalation and worker reliability scorecards.
model DispatchOffer {
  id            String               @id @default(uuid()) @db.Uuid
  serviceItemId String               @map("service_item_id") @db.Uuid
  supplierId    String               @map("supplier_id") @db.Uuid
  status        DispatchOfferStatus  @default(OFFERED)
  offeredAt     DateTime             @default(now()) @map("offered_at")
  deadline      DateTime
  respondedAt   DateTime?            @map("responded_at")
  declineReason String?              @map("decline_reason")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  serviceItem ServiceItem      @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  supplier    SupplierProfile  @relation(fields: [supplierId], references: [id])

  @@index([serviceItemId])
  @@index([supplierId])
  @@index([status])
  @@map("dispatch_offers")
}

model PaymentReceipt {
  id           String        @id @default(uuid()) @db.Uuid
  reservationId String       @map("reservation_id") @db.Uuid
  gatewayTxId  String?       @map("gateway_tx_id")
  rail         PaymentRail
  currency     String        @default("EUR")
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  payoutStatus PayoutStatus  @default(ACCRUED) @map("payout_status")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("payment_receipts")
}

model Document {
  id            String       @id @default(uuid()) @db.Uuid
  reservationId String       @map("reservation_id") @db.Uuid
  type          DocumentType
  storageKey    String       @map("storage_key")
  generatedAt   DateTime     @default(now()) @map("generated_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("documents")
}

model Message {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @map("reservation_id") @db.Uuid
  sender        MessageSender
  body          String
  readAt        DateTime?     @map("read_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("messages")
}

model Availability {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  date       DateTime @db.Date
  isAvailable Boolean @default(true) @map("is_available")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, date])
  @@map("availabilities")
}

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  supplierId    String?  @map("supplier_id") @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("reviews")
}

model Incident {
  id            String    @id @default(uuid()) @db.Uuid
  reservationId String    @map("reservation_id") @db.Uuid
  category      String
  description   String
  severity      String
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("incidents")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
