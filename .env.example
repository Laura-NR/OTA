# Copy to .env.local and fill in. Never commit real secrets.

# Runtime
NODE_ENV=development
PORT=3001
TENANT_ID=cuba-eco-travel

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://ota:ota@localhost:5432/ota_dev
# Read-only connection used by tooling/MCP
DATABASE_READONLY_URL=postgresql://ota_ro:ota_ro@localhost:5432/ota_dev

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_BUCKET=ota-documents

# Auth
AUTH_SECRET=replace-with-a-long-random-value

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.test

# Documents / tenant branding (MINTUR license is injected into every PDF)
TENANT_CONFIG_PATH=../../tenant/agency.config.json
DOCUMENTS_DIR=./.documents

# Payments (leave unset until ADR 0002; mock adapter is used otherwise)
# PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=
# GOCARDLESS_ACCESS_TOKEN=
# TROPIPAY_CLIENT_ID=
# TROPIPAY_CLIENT_SECRET=

# AI (optional)
# AI_PROVIDER=
# AI_API_KEY=

# opencode GitHub MCP (read from environment; never hardcode)
# GITHUB_PERSONAL_ACCESS_TOKEN=
